node_modules/

# Built single-file copy for publishing as a Claude artifact - derived from
# index.html + src/, so there's no reason to track it.
dist/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# The owner's drafts: content not ready for content/ yet.
drafts/

# The owner's reference photos and sketches (D97): local only, too big to track.
docs/design/
# Naming data for NPCs, local only (for now)
docs/names/

# The Python tools' environment (tools/py.mjs, npm run cutout setup).
.venv-cutout/
__pycache__/

# Sprite exports for marking up in Paint (npm run sprite export): read back into the code, never tracked.
art/*.png
art/*.bmp
# The face-part templates (npm run face-template): made from the code, so never tracked.
art/*.pdf
