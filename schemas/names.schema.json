{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The name generator's parts: a prefix and a suffix make a name",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "placeholder": {
      "$ref": "common.schema.json#/definitions/placeholder"
    },
    "id": {
      "const": "names"
    },
    "prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "suffixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "prefixes",
    "suffixes"
  ],
  "additionalProperties": false
}
