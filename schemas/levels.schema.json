{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The XP curve (\u00a7C.1)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "placeholder": {
      "$ref": "common.schema.json#/definitions/placeholder"
    },
    "id": {
      "const": "levels"
    },
    "xp": {
      "description": "The XP needed to reach each level, from level 0.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "reveal": {
      "description": "Hidden numbers shown from a level on (R5.2, R5.3, D107): a roll's kind (resistance, bite, treasure), or a location's completion -> the level. Items and perks reveal them with the reveal* game values.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "resistance",
          "bite",
          "treasure",
          "completion"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "universal": {
      "description": "The levels that offer a choice of two universal perks (D96). Class perks say their own level.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "required": [
    "id",
    "xp",
    "universal"
  ],
  "additionalProperties": false
}
