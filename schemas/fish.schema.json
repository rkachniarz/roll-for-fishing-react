{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A fish species (R4.1)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "placeholder": { "$ref": "common.schema.json#/definitions/placeholder" },
    "id": { "$ref": "common.schema.json#/definitions/id" },
    "name": { "$ref": "common.schema.json#/definitions/text" },
    "subnames": {
      "description": "One is picked per fish: Rainbow Trout, Northern Pike.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/text" }
    },
    "size": {
      "description": "In whole centimetres. Split into six equal slices, one per size band (R3.3).",
      "type": "object",
      "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "rift": {
      "description": "A fish from another world, found only in the spots' rift tables, through the wizard's Rift Fishing (D104).",
      "type": "boolean"
    },
    "difficulty": { "description": "Added to the size band's difficulty.", "type": "integer" },
    "stew": {
      "description": "What this fish adds to the perpetual stew's buff, and what eating it gives (R19.4, R21.1).",
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/effect" }
    },
    "rarity": {
      "description": "The species' rarity; the size band shifts it (D49, D63).",
      "$ref": "common.schema.json#/definitions/rarity"
    },
    "swims": {
      "description": "Which quarter of the water it keeps to, side on (the aquarium, the dive, the title): where the real fish spends most of its time (D136).",
      "enum": ["surface", "upper", "lower", "bottom"]
    },
    "prefers": {
      "description": "When the fish is likelier (D101): each preference the moment meets multiplies its weight in a table by the factor in rules/fish-preferences.json. Leave one out for no preference (\"Any\").",
      "type": "object",
      "properties": {
        "time": {
          "description": "Parts of the day (src/engine/time.js).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dawn", "morning", "noon", "afternoon", "sunset", "evening", "night"] }
        },
        "weather": { "description": "Weather words from rules/fish-preferences.json.", "$ref": "#/definitions/ids" },
        "season": { "description": "Season ids.", "$ref": "#/definitions/ids" },
        "bait": { "description": "Bait kinds from rules/fish-preferences.json.", "$ref": "#/definitions/ids" }
      },
      "additionalProperties": false
    },
    "icon": { "$ref": "common.schema.json#/definitions/icon" },
    "retired": { "$ref": "common.schema.json#/definitions/retired" }
  },
  "required": ["id", "name", "size", "difficulty", "rarity"],
  "additionalProperties": false,
  "definitions": {
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/definitions/id" } }
  }
}
