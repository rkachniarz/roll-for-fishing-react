{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fish size bands, smallest first (R3.3)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "placeholder": { "$ref": "common.schema.json#/definitions/placeholder" },
    "id": { "const": "size-bands" },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "$ref": "common.schema.json#/definitions/text" },
          "plain": { "description": "A fish of this size has no size word in its name: \"Northern Pike\", not \"Medium Northern Pike\".", "type": "boolean" },
          "weight": { "$ref": "common.schema.json#/definitions/weight" },
          "difficulty": { "description": "Added to the species' difficulty.", "type": "integer" },
          "rarity": {
            "description": "Tiers added to the species' rarity, never below Poor or above Epic (D63).",
            "type": "integer"
          }
        },
        "required": ["id", "name", "weight", "difficulty", "rarity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "bands"],
  "additionalProperties": false
}
